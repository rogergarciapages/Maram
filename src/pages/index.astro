			<div class="px-6 lg:px-16 py-16 max-w-[1280px] mx-auto">
				<div
					class="grid grid-cols-1 md:grid-cols-12 gap-8 pb-12 border-b border-[#F1EDE0]/20"
				>
					<!-- Col 1: Corporate Identity & Logo (4 Cols) -->
					<div class="md:col-span-4 space-y-4">
						<div class="flex flex-col items-start gap-2">
							<img
								src={logoLight}
								alt={companyName}
								class="h-16 lg:h-20 w-auto object-contain p-1 -ml-1"
							/>
							<div class="flex flex-col">
								<span
									class="font-bold text-white text-base leading-snug"
									>{companyName}</span
								>
								<span
									class="text-[10px] uppercase tracking-wider text-[#F1EDE0] font-semibold"
									>Construcción & Promociones Inmobiliarias</span
								>
							</div>
						</div>
						<p class="text-xs text-[#FAF9F6]/80 leading-relaxed">
							Empresa constructora y promotora especializada en la
							edificación de obra nueva, venta de casas, pisos y
							reformas integrales de máxima calidad en Tenerife.
						</p>
						<div class="text-xs text-[#FAF9F6]/80/80 space-y-1 pt-1">
							<p>
								<strong>NIF / CIF:</strong> B-38974512 (Registro Mercantil
								Sta. Cruz de Tenerife)
							</p>
							<p>
								<strong>Domicilio:</strong> Polígono San Gerónimo,
								La Orotava, Tenerife
							</p>
						</div>
					</div>

					<!-- Col 2: SEO Targeted Locations & Obra Nueva (3 Cols) -->
					<div class="md:col-span-3 space-y-3">
						<h4
							class="font-heading font-bold text-sm uppercase tracking-wider text-[#F1EDE0]"
						>
							Obra Nueva por Zonas
						</h4>
						<ul class="space-y-1.5 text-xs text-[#FAF9F6]/80">
							<li>
								<a
									href="#promociones"
									class="hover:text-[#FAF9F6] transition-colors"
									>Obra Nueva en Tenerife Sur</a
								>
							</li>
							<li>
								<a
									href="#promociones"
									class="hover:text-[#FAF9F6] transition-colors"
									>Venta de Casas en Santa Cruz</a
								>
							</li>
							<li>
								<a
									href="#promociones"
									class="hover:text-[#FAF9F6] transition-colors"
									>Promociones en Adeje & El Duque</a
								>
							</li>
							<li>
								<a
									href="#promociones"
									class="hover:text-[#FAF9F6] transition-colors"
									>Pisos Nuevos en La Orotava</a
								>
							</li>
							<li>
								<a
									href="#promociones"
									class="hover:text-[#FAF9F6] transition-colors"
									>Chalets en San Isidro & Granadilla</a
								>
							</li>
							<li>
								<a
									href="#promociones"
									class="hover:text-[#FAF9F6] transition-colors"
									>Adosados con Jardín en Tacoronte</a
								>
							</li>
							<li>
								<a
									href="#promociones"
									class="hover:text-[#FAF9F6] transition-colors"
									>Viviendas en Los Cristianos</a
								>
							</li>
						</ul>
					</div>

					<!-- Col 3: Servicios & Soluciones (2.5 Cols -> md:col-span-2) -->
					<div class="md:col-span-2 space-y-3">
						<h4
							class="font-heading font-bold text-sm uppercase tracking-wider text-[#F1EDE0]"
						>
							Servicios
						</h4>
						<ul class="space-y-1.5 text-xs text-[#FAF9F6]/80">
							<li>
								<a
									href="#servicios"
									class="hover:text-[#FAF9F6] transition-colors"
									>Promotora Inmobiliaria</a
								>
							</li>
							<li>
								<a
									href="#servicios"
									class="hover:text-[#FAF9F6] transition-colors"
									>Constructora Llave en Mano</a
								>
							</li>
							<li>
								<a
									href="#servicios"
									class="hover:text-[#FAF9F6] transition-colors"
