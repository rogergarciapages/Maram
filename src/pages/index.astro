---
import { supabase } from "../lib/supabase";
import "../styles/tailwind.css";

// Fetch client survey context for ASESORES INMOBILIARIOS MARAM SL dynamically from Supabase
const { data: clientSurveys } = await supabase
	.from("client_surveys")
	.select("*")
	.ilike("company_name", "%ASESORES INMOBILIARIOS MARAM%")
	.limit(1);

const client =
	clientSurveys && clientSurveys.length > 0 ? clientSurveys[0] : null;

const companyName = client?.company_name || "ASESORES INMOBILIARIOS MARAM SL";
const phone1 = client?.phone_1 || "673583698";
const phone2 = client?.phone_2 || "664476066";
const whatsapp = client?.whatsapp || "673583698";
const email = client?.email || "asesoresinmobiliariosmaramsl@hotmail.com";
const address =
	client?.address ||
	"C/ Ingenieros Azucareros, esq. C/ Ganadería, Polígono San Gerónimo, La Orotava, Santa Cruz de Tenerife";

const historyText =
	client?.history ||
	"Nuestra empresa nació con la ilusión de ofrecer un servicio de construcción basado en la calidad, la confianza y el compromiso con cada cliente. Desde nuestros inicios, hemos trabajado con esfuerzo, responsabilidad y dedicación, creciendo proyecto a proyecto gracias a la satisfacción de quienes han confiado en nosotros. Hoy seguimos manteniendo los mismos valores que nos impulsaron desde el primer día: profesionalidad, honestidad y excelencia en cada obra que realizamos.";

const missionText =
	client?.mission ||
	"Construimos más que edificios, construimos confianza. Nuestra misión es ofrecer proyectos de construcción de máxima calidad, adaptados a las necesidades de cada cliente. Nos comprometemos a trabajar con seriedad, transparencia y profesionalidad, garantizando un servicio cercano, materiales de primera calidad y el cumplimiento de los plazos acordados.";

const diffText =
	client?.differentiation ||
	"Nos diferenciamos por nuestro compromiso con la calidad, la seriedad y el trato cercano, ofreciendo soluciones personalizadas y cumpliendo siempre con los plazos acordados.";

const whyUsText =
	client?.why_choose_us ||
	"Porque para nosotros cada cliente es único. Nos implicamos en cada proyecto como si fuera propio, ofreciendo un trato cercano, asesoramiento personalizado y un trabajo realizado con dedicación y profesionalidad. Nuestro objetivo no es solo construir, sino generar confianza y que nuestros clientes se sientan tranquilos durante todo el proceso.";

const logoDark = "/Maram_dark2_XS.png";
const logoLight = "/Maram_light_XS.png";

const siteUrl = "https://maram-inmobiliaria-construccion.es";
const pageTitle = `${companyName} | Obra Nueva en Tenerife, Promotora y Constructora de Casas`;
const pageDescription = `${companyName} - Inmobiliaria y constructora experta en obra nueva en Tenerife, venta de pisos, casas en Tenerife Sur, Santa Cruz y La Orotava. Servicios inmobiliarios de máxima calidad.`;
---

<!doctype html>
<html class="scroll-smooth" lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
