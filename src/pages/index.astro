							>
								02
							</div>
							<h4
								class="font-heading font-bold text-lg text-[#343B43] group-hover:text-[#343B43] transition-colors"
							>
								Tranquilidad & Plazos
							</h4>
							<p class="text-xs text-[#343B43]/80 leading-relaxed">
								Garantía de presupuesto cerrado y cumplimiento
								estricto de los plazos de entrega pactados para
								tu absoluta tranquilidad y serenidad.
							</p>
						</div>

						<!-- Step 3 -->
						<div
							class="bg-white p-8 rounded-xl border border-[#F1EDE0] shadow-sm hover:border-[#343B43] transition-all space-y-4 group"
						>
							<div
								class="w-12 h-12 bg-[#343B43] text-[#FAF9F6] rounded-lg flex items-center justify-center font-bold text-lg font-heading shadow-md shadow-[#343B43]/20"
							>
								03
							</div>
							<h4
								class="font-heading font-bold text-lg text-[#343B43] group-hover:text-[#343B43] transition-colors"
							>
								Materiales Nobles
							</h4>
							<p class="text-xs text-[#343B43]/80 leading-relaxed">
								Selección minuciosa de acabados y técnicas
								constructivas que aseguran durabilidad y confort
								térmico en Canarias.
							</p>
						</div>

						<!-- Step 4 -->
