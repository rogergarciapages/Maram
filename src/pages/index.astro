				"name": "ASESORES INMOBILIARIOS MARAM SL",
				"description": "Constructora y promotora inmobiliaria especializada en obra nueva en Tenerife, venta de casas, pisos y reformas integrales.",
				"url": "https://maram-inmobiliaria-construccion.es",
				"address": {
					"@type": "PostalAddress",
					"streetAddress": "C/ Ingenieros Azucareros, esq. C/ Ganadería, Polígono San Gerónimo",
					"addressLocality": "La Orotava",
					"addressRegion": "Santa Cruz de Tenerife",
					"addressCountry": "ES"
				},
				"telephone": "+34-673583698",
				"email": "asesoresinmobiliariosmaramsl@hotmail.com",
				"areaServed": [
					"Tenerife",
					"Santa Cruz de Tenerife",
					"Tenerife Sur",
					"La Orotava"
