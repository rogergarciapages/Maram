								src="https://lh3.googleusercontent.com/aida-public/AB6AXuDdCHO5x8TqK0NP_ZdMerkB83axnaVQiNJHhkiQUulNIjF0MpZShmxWlL2GMnSIBPQ0b16XIbv2xMksHHa2kLHHqQfzIMFN6UsD3txQTmdwtaNRaqyOJgUYFGH2Rx6Zs7t4WCRc71L2dXTQo8V_L5XP5LyZgufSzOt9mKgI54goE2PIC14uQ6hLbEJTwd6h_m675enCyxAagzmcQfChrPLSZti_3A0UVkF3wltsLVY5KAW86Qmzg5DU4EiKQm4gIQdYpRTsRAg0gA"
								alt="Mapa de desarrollos inmobiliarios y obra nueva en Tenerife"
							/>
						</div>
					</div>
				</div>
			</section>

			<!-- Contact / Form Section -->
			<section
				id="contacto"
				class="py-24 bg-[#F1EDE0] border-t border-[#343B43]/20"
			>
				<div class="px-6 lg:px-16 max-w-[1280px] mx-auto">
					<div class="grid grid-cols-1 md:grid-cols-12 gap-12">
						<div class="md:col-span-5 space-y-6">
							<span
								class="text-[12px] font-bold text-[#343B43] uppercase tracking-[0.2em] block"
								>Contacto Directo</span
							>
							<h2
								class="text-3xl lg:text-4xl font-bold text-[#343B43] font-heading"
							>
								Contacte con nuestros Asesores Inmobiliarios
							</h2>
							<p class="text-[#343B43]/80 text-base">
								Póngase en contacto con nuestra empresa
								constructora para consultar promociones de obra
								nueva, comprar casa en Tenerife o solicitar un
								presupuesto sin compromiso.
							</p>

							<div class="space-y-4 pt-4 text-sm text-[#343B43]/80">
								<div class="flex items-start gap-3">
									<span
										class="material-symbols-outlined text-[#343B43]"
										>location_on</span
									>
									<p>
										<strong>Oficina Central: </strong>
										{address}
									</p>
								</div>
								<div class="flex items-start gap-3">
									<span
										class="material-symbols-outlined text-[#343B43]"
										>call</span
									>
									<p>
										<strong>Teléfonos: </strong>
										<a
											href={`tel:${phone1}`}
											class="hover:underline">{phone1}</a
										> / <a
											href={`tel:${phone2}`}
											class="hover:underline">{phone2}</a
										>
									</p>
								</div>
								<div class="flex items-start gap-3">
									<span
										class="material-symbols-outlined text-[#343B43]"
										>mail</span
									>
									<p>
										<strong>Correo Electrónico: </strong>
										<a
											href={`mailto:${email}`}
											class="hover:underline">{email}</a
										>
									</p>
								</div>
							</div>
						</div>

						<div
							class="md:col-span-7 bg-white p-8 lg:p-10 border border-[#F1EDE0] shadow-xl rounded"
						>
							<h3
								class="font-heading text-2xl font-bold text-[#343B43] mb-6"
							>
								Solicitar información de obra nueva o inmuebles
							</h3>
							<form
								class="space-y-4"
								onsubmit="event.preventDefault(); alert('¡Gracias! Nos pondremos en contacto a la brevedad.');"
							>
								<div
									class="grid grid-cols-1 sm:grid-cols-2 gap-4"
								>
									<div>
										<label
											class="block text-[11px] font-bold uppercase text-[#343B43]/80 mb-1"
											for="name">Nombre Completo</label
										>
										<input
											id="name"
											type="text"
											required
											class="w-full px-4 py-3 border border-[#F1EDE0] bg-white text-[#343B43] focus:outline-none focus:border-[#343B43] rounded"
											placeholder="Ej. Juan Pérez"
										/>
									</div>
									<div>
										<label
											class="block text-[11px] font-bold uppercase text-[#343B43]/80 mb-1"
											for="phone">Teléfono</label
										>
										<input
											id="phone"
											type="tel"
											required
											class="w-full px-4 py-3 border border-[#F1EDE0] bg-white text-[#343B43] focus:outline-none focus:border-[#343B43] rounded"
											placeholder="Ej. 673 000 000"
										/>
									</div>
								</div>
								<div>
									<label
										class="block text-[11px] font-bold uppercase text-[#343B43]/80 mb-1"
										for="email">Correo Electrónico</label
									>
									<input
										id="email"
										type="email"
										required
										class="w-full px-4 py-3 border border-[#F1EDE0] bg-white text-[#343B43] focus:outline-none focus:border-[#343B43] rounded"
										placeholder="correo@ejemplo.com"
									/>
								</div>
								<div>
									<label
										class="block text-[11px] font-bold uppercase text-[#343B43]/80 mb-1"
										for="message"
										>Mensaje / Interés (Obra Nueva, Pisos,
										Casas)</label
									>
									<textarea
										id="message"
										rows="4"
										required
										class="w-full px-4 py-3 border border-[#F1EDE0] bg-white text-[#343B43] focus:outline-none focus:border-[#343B43] rounded"
										placeholder="Cuéntenos sobre su vivienda o proyecto de edificación..."
									></textarea>
								</div>

								<!-- Privacy Policy Checkbox -->
								<div class="flex items-start gap-3 pt-1 pb-2">
									<input
										id="privacy"
										type="checkbox"
										required
										class="mt-1 h-4 w-4 rounded border-[#F1EDE0] text-[#343B43] focus:ring-[#343B43] accent-[#343B43] cursor-pointer"
									/>
									<label
										for="privacy"
										class="text-xs text-[#343B43]/80 cursor-pointer select-none leading-relaxed"
									>
										He leído y acepto la <a
											href="#"
											class="text-[#343B43] underline font-medium hover:text-[#252A30]"
											>Política de Privacidad</a
										> y el tratamiento de mis datos personales
										para la gestión de la consulta.
									</label>
								</div>

								<button
									type="submit"
									class="w-full bg-brand-red-gradient hover:opacity-95 text-white py-4 text-[12px] font-bold uppercase tracking-[0.1em] transition-all shadow-md shadow-[#343B43]/20 rounded"
								>
									Enviar Solicitud
								</button>
							</form>
						</div>
					</div>
				</div>
			</section>
		</main>

